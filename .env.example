# Plantilla de ejemplo. Los archivos .env y .env.docker los crea configurar_local.py.
PORT=5090
LAGO_USUARIOS_URL=http://127.0.0.1:5181
LAGO_PUESTOS_URL=http://127.0.0.1:5182
LAGO_ADMIN_USER=admin
LAGO_SECRET_KEY=VALOR_GENERADO_LOCALMENTE
LAGO_SERVICE_TOKEN=VALOR_GENERADO_LOCALMENTE
LAGO_ADMIN_PASSWORD_HASH=HASH_GENERADO_LOCALMENTE
LAGO_COOKIE_SECURE=0
