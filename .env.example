# Plantilla: no pongas aqui claves reales. El archivo .env local se ignora en Git.
LAGO_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
LAGO_ADMIN_USER=admin
# Configura un hash Werkzeug con generate_password_hash; nunca subas contrasenas reales.
LAGO_ADMIN_PASSWORD_HASH=REEMPLAZAR_POR_HASH_WERKZEUG
# En alojamiento HTTPS, configura LAGO_COOKIE_SECURE=1
LAGO_COOKIE_SECURE=0
